{
  "version": 1,
  "title": "connect-ai-motion in ten lines",
  "style": "connect",
  "bg": "kit/bg-pool",
  "sound": false,
  "allow": [
    "CONNECT AI LAB"
  ],
  "beats": [
    {
      "id": "open",
      "say": "CONNECT AI LAB. AI education for everyone.",
      "kind": "kit/ident",
      "text": "CONNECT AI LAB",
      "sub": "AI education for everyone",
      "dur": 2.4
    },
    {
      "id": "promise",
      "say": "No footage. Only a script. A finished film.",
      "kind": "kit/photo-strip",
      "images": [
        "kit:examples/media/photo-3.jpg",
        "kit:examples/media/photo-1.jpg",
        "kit:examples/media/photo-2.jpg",
        "kit:examples/media/photo-4.jpg"
      ],
      "text": "A finished film",
      "sub": "No footage",
      "dur": 3.0
    },
    {
      "id": "one",
      "say": "One line of your script is one scene.",
      "kind": "remotion/rough-mark",
      "text": "One line is one scene",
      "hi": "one scene",
      "mark": "highlight",
      "color": "coral",
      "dur": 2.8,
      "bg": {
        "kind": "kit/bg-pool",
        "color": "coral",
        "x": 40
      }
    },
    {
      "id": "sources",
      "say": "Scenes come from Remotion, HyperFrames, Lottie, GSAP, three.js, shaders, or your own file.",
      "kind": "kit/node-graph",
      "items": [
        "Scenes",
        "Remotion",
        "HyperFrames",
        "Lottie",
        "GSAP",
        "three.js",
        "Shaders"
      ],
      "hi": "Scenes",
      "dur": 4.2
    },
    {
      "id": "flow",
      "say": "Write the script, pick the scenes, check, render.",
      "kind": "kit/draw-route",
      "items": [
        "Script",
        "Scenes",
        "Check",
        "Render"
      ],
      "dur": 3.8
    },
    {
      "id": "rhythm",
      "say": "The check keeps the rhythm: something new every three seconds.",
      "kind": "hyperframes/ring-count",
      "value": "3",
      "unit": "seconds",
      "dur": 2.8,
      "bg": {
        "kind": "kit/bg-pool",
        "color": "teal",
        "x": 60
      }
    },
    {
      "id": "check",
      "say": "It checks itself before it renders.",
      "kind": "lottie/gold-check",
      "text": "Check",
      "sub": "before it renders",
      "dur": 2.2
    },
    {
      "id": "agent",
      "say": "Or just ask your agent: make a film from this script.",
      "kind": "remotion/cursor-prompt",
      "text": "Make a film from this script",
      "dur": 3.4
    },
    {
      "id": "shapes",
      "say": "16:9 and 9:16 come from the same storyboard.",
      "kind": "kit/device-duo",
      "src": "kit:examples/media/shot-1.jpg",
      "src2": "kit:examples/media/shot-tall-1.jpg",
      "items": [
        "16:9",
        "9:16"
      ],
      "color": "teal",
      "dur": 3.2
    },
    {
      "id": "end",
      "say": "Open source by CONNECT AI LAB.",
      "kind": "kit/endcard",
      "text": "CONNECT AI LAB",
      "sub": "Open source",
      "items": [
        "youtube.com/@CONNECT-AI-LAB",
        "aicitybuilders.com"
      ],
      "in": "remotion/tr-fade",
      "dur": 3.2
    }
  ]
}