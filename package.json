{
  "name": "connect-ai-motion",
  "version": "0.3.0",
  "description": "No footage needed: a script becomes a finished motion graphics video. One line is one full-frame scene, and most scenes are pictures, not text cards: charts, line drawings, diagrams, 3D, your screenshots and photos in devices and frames. Remotion packages, HyperFrames blocks, Lottie, three.js, shaders and your own components are all one line in a storyboard, in 16:9 and 9:16, with a rhythm check.",
  "type": "module",
  "license": "MIT",
  "author": "CONNECT AI LAB",
  "bin": {
    "connect-ai-motion": "bin/cli.mjs"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "demo": "node bin/cli.mjs demo",
    "check": "node bin/cli.mjs check",
    "test": "node tests/run.mjs",
    "motion": "node bin/cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "@remotion/animation-utils": "4.0.529",
    "@remotion/bundler": "4.0.529",
    "@remotion/captions": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/gsap": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/light-leaks": "4.0.529",
    "@remotion/lottie": "4.0.529",
    "@remotion/mac-cursors": "4.0.529",
    "@remotion/motion-blur": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/rough-notation": "4.0.529",
    "@remotion/rounded-text-box": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "@remotion/starburst": "4.0.529",
    "@remotion/svg-3d-engine": "4.0.529",
    "@remotion/three": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "gsap": "3.15.0",
    "katex": "0.16.22",
    "lottie-web": "5.13.0",
    "prismjs": "1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529",
    "shaders": "4.0.2",
    "three": "0.170.0"
  },
  "files": [
    "bin/",
    "lib/",
    "src/",
    "!src/catalog/user.generated.tsx",
    "catalog/",
    "skill/",
    "licenses/",
    "examples/",
    "tests/",
    "my-info.json",
    "remotion.config.ts",
    "tsconfig.json",
    "NOTICE.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonseokjung/connect-ai-motion.git"
  },
  "homepage": "https://github.com/wonseokjung/connect-ai-motion#readme",
  "keywords": [
    "remotion",
    "motion-graphics",
    "storyboard",
    "explainer",
    "hyperframes",
    "lottie",
    "gsap",
    "shaders",
    "three",
    "charts",
    "diagrams",
    "script-to-video",
    "agent-skill"
  ]
}
